# Copy to .env and fill in. .env is gitignored and must never be committed.

# Gemini API key (https://aistudio.google.com/apikey).
# Leave blank to run entirely on the deterministic fallback engine, with no network calls.
GEMINI_API_KEY=

# Random string, at least 32 characters. Used to sign JWTs.
JWT_SECRET=

# Flash-tier model. gemini-1.5-flash is retired and will not resolve.
LITELLM_MODEL=gemini/gemini-2.5-flash

# Embedding model used by the retrieval benchmark. text-embedding-004 was withdrawn in Jan 2026.
EMBEDDING_MODEL=gemini/gemini-embedding-001

# JWT lifetime.
TOKEN_TTL_HOURS=24

# SQLite file.
DATABASE_PATH=support_assistant.db

# Optional. Seconds to wait before each model call. The free tier allows only a small
# number of requests per minute, and the evaluation runner makes more calls in a burst
# than that allows, so a full run comes back partly unmeasured. 5 is enough on the free
# tier. Leave at 0 to call as fast as the provider permits.
LLM_PACE_SECONDS=0
